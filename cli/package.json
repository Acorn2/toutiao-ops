{
  "name": "@openclaw-cn/toutiao-ops",
  "version": "0.1.4",
  "type": "module",
  "private": true,
  "engines": { "node": ">=20" },
  "description": "今日头条长文章本地 CLI：多账号身份确认、Markdown 校验、草稿保存与发布记录回查",
  "keywords": [
    "toutiao",
    "头条号",
    "今日头条",
    "自媒体",
    "自动化",
    "browser-automation",
    "playwright",
    "openclaw"
  ],
  "license": "MIT",
  "author": "OpenClaw-CN",
  "repository": {
    "type": "git",
    "url": "https://github.com/jiulingyun/toutiao-ops"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "toutiao-ops": "index.js"
  },
  "files": [
    "index.js",
    "src/"
  ],
  "scripts": {
    "start": "node index.js",
    "test": "node --test test/*.test.js",
    "test:browser": "node --test test-browser/*.test.js",
    "check": "node scripts/check.js"
  },
  "dependencies": {
    "commander": "12.1.0",
    "marked": "17.0.5",
    "playwright": "1.56.1"
  }
}
